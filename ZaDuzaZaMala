XML:
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Za dużo, za mało"
        android:textSize="24sp"
        android:layout_gravity="center"
        />
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/pytanie"
        android:layout_gravity="center"
        />
    <EditText
        android:id="@+id/zgadywana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Zgadnij liczbę 1-100"
        android:gravity="center"
        android:padding="10dp"
        android:layout_margin="10dp"
        android:inputType="number"
        android:imeOptions="actionDone"
        />
    <Button
        android:id="@+id/sprawdz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Sprawdź"
        android:layout_margin="7dp"
        />
    <TextView
        android:id="@+id/wynik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tu pojawi się wynik"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_margin="7dp"
        />

</LinearLayout>


Main JAVA:

package com.example.zaduzozamalo;

import android.os.Bundle;
import android.view.View;
import android.widget.Button;
import android.widget.EditText;
import android.widget.TextView;

import androidx.activity.EdgeToEdge;
import androidx.appcompat.app.AppCompatActivity;
import androidx.core.graphics.Insets;
import androidx.core.view.ViewCompat;
import androidx.core.view.WindowInsetsCompat;

public class MainActivity extends AppCompatActivity {
    EditText zgadywana;
    Button sprawdz;
    TextView wynik;
    Integer losowana;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        EdgeToEdge.enable(this);
        setContentView(R.layout.activity_main);

        ViewCompat.setOnApplyWindowInsetsListener(findViewById(R.id.main), (v, insets) -> {
            Insets systemBars = insets.getInsets(WindowInsetsCompat.Type.systemBars());
            v.setPadding(systemBars.left, systemBars.top, systemBars.right, systemBars.bottom);
            return insets;
        });
        zgadywana=findViewById(R.id.zgadywana);
        sprawdz=findViewById(R.id.sprawdz);
        wynik=findViewById(R.id.wynik);
        losowana= (int) (Math.random()*100+1);
        sprawdz.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                String komunikat = "";
                String zgadywanaStr = zgadywana.getText().toString();
                if (zgadywanaStr.isEmpty()) {
                    komunikat += "Musisz podać liczbę!";
                    wynik.setText(komunikat);
                }
                if (komunikat.isEmpty()) {
                    Integer zgadywanaInt = Integer.parseInt(zgadywanaStr);
                    if (zgadywanaInt == losowana) {
                        wynik.setText(String.format("Brawo, %d to ta liczba!", zgadywanaInt));
                        losowana= (int) (Math.random()*100+1);
                        zgadywana.setText("");
                    } else if (zgadywanaInt < losowana) {
                        wynik.setText(String.format("%d jest za mała!",zgadywanaInt));
                        zgadywana.setText("");
                    } else {
                        wynik.setText(String.format("%d jest za duża!",zgadywanaInt));
                        zgadywana.setText("");
                    }

                }

            }
        });
    }
}
